<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Tapping the time opens the clock's alarm list. AOSP-based clocks (OnePlus, Oppo, …) only
         accept that from apps holding this. Granted at install; it shows no prompt. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Contacts appear in search. Requested the first time search opens. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- File names appear in search. Android 11+: "All files access", granted by the user in
         Settings from the prompt in search. Older versions: the storage permission. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Package visibility (Android 11+): let PackageManager see launchable apps, the
         clock app (by its alarm and timer actions), the calendar, the contacts app, the dialer,
         apps that open files and the Settings screens search opens. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_TIMERS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data
                android:host="com.android.calendar"
                android:scheme="content" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.cursor.item/contact" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <!-- The Settings screens search lists (data/SettingsProvider.kt): each action must be here
             for its handler to be found. -->
        <intent>
            <action android:name="android.settings.WIFI_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.WIRELESS_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.AIRPLANE_MODE_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.DATA_ROAMING_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.NETWORK_OPERATOR_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.APN_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.DATA_USAGE_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.TETHER_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.VPN_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.BLUETOOTH_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.NFC_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.NFC_PAYMENT_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.CAST_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.DISPLAY_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.NIGHT_DISPLAY_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.DREAM_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.SOUND_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.panel.action.VOLUME" />
        </intent>
        <intent>
            <action android:name="android.settings.NOTIFICATION_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.ALL_APPS_NOTIFICATION_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.ZEN_MODE_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.APPLICATION_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.MANAGE_APPLICATIONS_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.MANAGE_DEFAULT_APPS_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.HOME_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.USAGE_ACCESS_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.ACTION_NOTIFICATION_LISTENER_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.NOTIFICATION_POLICY_ACCESS_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.action.MANAGE_OVERLAY_PERMISSION" />
        </intent>
        <intent>
            <action android:name="android.settings.action.MANAGE_WRITE_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.IGNORE_BATTERY_OPTIMIZATION_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.MANAGE_UNKNOWN_APP_SOURCES" />
        </intent>
        <intent>
            <action android:name="android.settings.MANAGE_ALL_FILES_ACCESS_PERMISSION" />
        </intent>
        <intent>
            <action android:name="android.intent.action.POWER_USAGE_SUMMARY" />
        </intent>
        <intent>
            <action android:name="android.settings.BATTERY_SAVER_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.INTERNAL_STORAGE_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.SECURITY_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.app.action.SET_NEW_PASSWORD" />
        </intent>
        <intent>
            <action android:name="android.settings.BIOMETRIC_ENROLL" />
        </intent>
        <intent>
            <action android:name="android.settings.PRIVACY_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.LOCATION_SOURCE_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.SYNC_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.ADD_ACCOUNT_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.ACCESSIBILITY_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.CAPTIONING_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.LOCALE_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.REGIONAL_PREFERENCES_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.INPUT_METHOD_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.HARD_KEYBOARD_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.USER_DICTIONARY_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.VOICE_INPUT_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.DATE_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.ACTION_PRINT_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.APPLICATION_DEVELOPMENT_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.DEVICE_INFO_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.SHOW_REGULATORY_INFO" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HALauncher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Locks the screen on a double-tap of the empty home screen, via the device-admin API
             (DevicePolicyManager.lockNow) rather than an accessibility service, so security-sensitive
             apps don't flag the launcher. Bound only by the system (BIND_DEVICE_ADMIN), after the user
             activates it in the device-admin dialog. It declares only the force-lock policy; see
             LockAdminReceiver and res/xml/device_admin.xml. -->
        <receiver
            android:name=".service.LockAdminReceiver"
            android:exported="true"
            android:label="@string/lock_admin_label"
            android:description="@string/lock_admin_description"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>