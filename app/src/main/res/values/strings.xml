    <string name="lock_admin_label">HALauncher: lock screen</string>
    <string name="lock_admin_description">Lets HALauncher lock your screen when you double-tap an empty area of the home screen. It can\'t read your screen, wipe data or change your password.</string>
    <string name="lock_admin_explanation">HALauncher uses this only to lock the screen when you double-tap the home screen. It can\'t read your screen or change anything else.</string>
    <string name="lock_permission_title">Lock with a double-tap</string>
    <string name="lock_permission_message">To lock your phone by double-tapping the home screen, let HALauncher lock the screen on the next dialog. It\'s used only to lock the screen — it can\'t read your screen or change anything else.</string>
    <string name="lock_open_settings">Continue</string>
    <string name="lock_failed">Couldn\'t lock the screen</string>
    <string name="lock_settings_unavailable">Device admin settings not found</string>
    <string name="settings_title">Settings</string>
    <string name="open_launcher_settings">Launcher settings</string>
    <string name="setting_lock_title">Lock settings</string>
    <string name="setting_lock_description">Freeze every setting so nothing changes by accident. While on, the other settings are greyed out, the gallery, messages and payments buttons and the date\'s calendar app can\'t be changed, and long-pressing the app sphere won\'t open its editor. Turn this off to make changes again.</string>
    <string name="setting_double_tap_lock_title">Double-tap to lock</string>
    <string name="setting_double_tap_lock_description">Double-tap an empty part of the home screen to lock your phone. Turning this on asks you to let HALauncher lock the screen; it\'s used only for that — it can\'t read your screen or change anything else. Turning it off removes that access.</string>
    <string name="setting_default_search_category_title">Default search category</string>
    <string name="setting_default_search_category_description">Which category search starts on each time you open it. \"All\" searches everything.</string>
    <string name="setting_home_text_color_title">Home screen colour</string>
    <string name="setting_home_text_color_description">Colour of the clock, icons and app sphere over your wallpaper. Auto uses dark on light wallpapers and light on the rest; pick Light or Dark if it gets yours wrong.</string>
    <string name="home_text_color_auto">Auto</string>
    <string name="home_text_color_light">Light</string>
    <string name="home_text_color_dark">Dark</string>
    <string name="setting_reduce_index_title">Reduce index size</string>
    <string name="setting_reduce_index_description">Leave files you\'d never open out of search — app backups, caches and the trash bin — so the index stays small and the app lighter. No extra permission: it works within the file access you\'ve already granted.</string>
    <string name="setting_haptic_intensity_title">Vibration intensity</string>
    <string name="setting_haptic_intensity_description">How strong the tick feels as you turn the app sphere, switch search categories and pull search in. Slide to Off for no vibration.</string>
    <string name="setting_haptic_intensity_off">Off</string>
