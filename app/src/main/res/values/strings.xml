    <string name="setup_title">Set up HALauncher</string>
    <string name="setup_intro">A couple of quick things so the launcher works its best. You can set these up now or later — open \"Set-up &amp; permissions\" in settings any time.</string>
    <string name="setup_default_home_title">Make HALauncher your home screen</string>
    <string name="setup_default_home_desc">Set HALauncher as your default home app so it opens whenever you press the Home button.</string>
    <string name="setup_contacts_title">Find your contacts</string>
    <string name="setup_contacts_desc">Let HALauncher read your contacts so you can search for people, then call or message them. It only reads them to search — nothing leaves your phone.</string>
    <string name="setup_files_title">Search your files</string>
    <string name="setup_files_desc">Give HALauncher file access so your documents, photos and downloads turn up in search.</string>
